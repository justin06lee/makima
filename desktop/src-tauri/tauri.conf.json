{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "makima",
  "version": "0.2.0",
  "identifier": "sh.makima.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "makima",
        "width": 920,
        "height": 620,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#ffffff",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Every machine you own, on one private network",
    "longDescription": "makima is a lightweight authenticated mesh for reaching services across the computers you own. This app shows what your mesh can see and lets you change it without a terminal.",
    "linux": {
      "deb": {
        "depends": [
          "polkit"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": [
      "binaries/makima",
      "binaries/makimad",
      "binaries/makima-server",
      "binaries/makima-relay"
    ]
  }
}
