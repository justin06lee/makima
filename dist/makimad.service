[Unit]
Description=makima node daemon
Documentation=https://github.com/justin06lee/makima
# The tunnel needs a working network to reach its control server and relay, and
# nothing that comes later should start before mesh addresses resolve.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/makimad
Restart=always
RestartSec=5

# The daemon holds a TUN device. SIGTERM lets it remove its routes and resolver
# entry on the way out; a KILL would leave both behind, and a machine that
# believes it can still reach mesh addresses down a dead interface blackholes
# them until the next reboot.
KillSignal=SIGTERM
TimeoutStopSec=20

# Root, and not narrowed. This unit used to keep only NET_ADMIN and NET_RAW and
# hide /home, and so broke, without a word, nearly everything the daemon does
# besides the tunnel: binding port 53 for mesh names, becoming the owner's
# account for an ssh session (and sudo inside one), handing the inbox and the
# desktop socket to the owner, reading their authorized_keys, finding the owner
# at all, driving ufw, and replacing its own binaries on a fleet update. The
# control plane and the relay need none of that, and their units are confined.
#
# `makima up` starts this unit as it is when it finds it, rather than writing
# its own over it.

[Install]
WantedBy=multi-user.target
