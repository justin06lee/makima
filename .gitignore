build/
*.test

# Bare binaries from a `go build ./cmd/...` that forgot -o; the Makefile always
# writes into build/, so anything by these names at the root is an accident.
/makima
/makimad
/makima-server
/makima-relay
/devserver

# Node and control-plane state, which hold private keys.
node.json
control.json
*.sock
dist/release/

# Desktop app build output. The Rust target directory is enormous and the
# bundles are rebuilt from source by `make app`.
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Other platforms' makima, built into the app by `make kits`.
desktop/src-tauri/kits/*.tar.gz
